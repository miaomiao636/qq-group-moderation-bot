# ============================================================
# 环境变量模板（安全说明）
# 复制为 .env 后填写真实值。真实凭据绝不提交到仓库。
# 所有敏感字段只从环境变量或系统凭据存储读取。
# ============================================================

# 运行环境：local / test / prod（仅允许这三个值）
APP_ENV=local

# 运行模式：SAFE（安全模式，默认）/ CONVENIENT（便捷模式，需负责人确认后启用）
RUN_MODE=SAFE

# 全局动作门禁：SHADOW 只记录；OFFICIAL 是兼容保留名称，表示允许真实动作。
# 实际Adapter由provider路由选择，绝不把OneBot ID当OpenID。OFFICIAL要求prod、管理员口令、非急停；
# 官方出口另需QQ凭据；OneBot出口另需下方独立开关、固定账号和真人批准的按群动作开关。
ACTION_MODE=SHADOW
EMERGENCY_STOP=false

# 数据库连接串（首版只支持并验证单实例 SQLite WAL；持久inbox使用SQLite原子语句）
# 示例：sqlite+aiosqlite:///./data/moderation.db
DATABASE_URL=sqlite+aiosqlite:///./data/moderation.db

# 管理后台监听地址与端口（默认仅本机，禁止无保护暴露公网）
# 端口范围 1-65535；通过 `uv run python -m app` 启动时生效
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 管理后台鉴权（生产环境 APP_ENV=prod 必须设置非空强口令，否则拒绝启动）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_SECONDS=3600

# 通用Agent不持有管理员口令；两个独立令牌不能复用，不配置即禁用Agent API。
AGENT_API_READ_TOKEN=
AGENT_API_TOKEN=
# 默认只读；按需最小授权：settings:write,actions:enable,routing:write,emergency:stop,rules:publish,rules:rollback
# 授权写权限仍不能批准自身计划；高风险变更需要真人登录后台预览并批准。
AGENT_API_WRITE_SCOPES=project:read

# 数据保留期（天，必须 >= 1）
RAW_RETENTION_DAYS=30
DECISION_RETENTION_DAYS=180
# 媒体总容量（字节，>0）；20 GiB = 21474836480。修改后重启加载，不自动删证据。
MEDIA_QUOTA_BYTES=2147483648

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# QQ 官方机器人凭据（真实值只写入本地 .env 或系统凭据，不提交仓库）
QQ_APP_ID=
QQ_APP_SECRET=
QQ_API_BASE=https://api.bot.qq.com

# 远程AI（默认关闭、按群启用）：明确视觉广告/诈骗走主模型，疑难才独立复核；失败只记录。
AI_ENABLED=false
AI_ENABLED_GROUPS=
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=5
AI_DAILY_BUDGET_CENTS=0
AI_PER_MINUTE_LIMIT=30
AI_DAILY_CALL_LIMIT=1000
AI_PROMPT_VERSION=t204-v17
# 业务规则片段文件（相对仓库根；仓库自带 config/ai_prompt_rules.txt）。
# 设置后文件必须存在且非空（fail-closed，防审核口径静默漂移）；留空则不追加。
AI_PROMPT_RULES_FILE=config/ai_prompt_rules.txt
# 金额0不是免费；供应商价格未接入时用调用上限+供应商账单核算真实成本。
AI_REVIEW_MODEL=
AI_REVIEW_BASE_URL=
AI_REVIEW_API_KEY=
AI_PRIMARY_DIRECT_THRESHOLD=0.90
AI_SECONDARY_REVIEW_LOW=0.60
AI_SECONDARY_REVIEW_HIGH=0.90

# NapCat/OneBot 11 反向WebSocket入站（T-306，默认关闭）
# 启用条件（fail-closed）：必须设置非空访问令牌；WEB_HOST 只能是本机回环或可信内网。
# NapCat 侧配置反向WS地址为 ws://<WEB_HOST>:<WEB_PORT>/onebot/ws，并在其Token配置中
# 设置同一个令牌，使连接使用 Authorization: Bearer 请求头；URL查询参数令牌会被拒绝。
# 令牌真实值只写入 Windows 本机环境变量或系统凭据存储，绝不提交仓库。
ONEBOT_WS_ENABLED=false
ONEBOT_ACCESS_TOKEN=
# 真实动作必须绑定专用QQ数字账号；影子空值会固定首个连接账号，不接受并行第二连接。
ONEBOT_SELF_ID=
ONEBOT_WS_PATH=/onebot/ws
ONEBOT_QUEUE_MAX=500
ONEBOT_HEARTBEAT_TIMEOUT_SECONDS=90
ONEBOT_ACTIONS_ENABLED=false
# 首次隔离/逐群试运行先只撤回；经负责人批准改full并重启才允许禁言/警告。
ONEBOT_ACTION_STAGE=recall_only
ONEBOT_ACTION_TIMEOUT_SECONDS=10

# 主动通知 R-106：独立于处罚开关，默认全关。启用通知可在SHADOW向管理群/邮箱发提醒，
# 仍不得对群成员处罚。真实群号/收件人/凭据仅在Windows本机填写；详见docs/proactive-notifications.md。
NOTIFICATIONS_ENABLED=false
NOTIFICATION_QQ_ENABLED=false
NOTIFICATION_QQ_GROUP_ID=
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_BACKUP_TO=
NOTIFICATION_TIMEOUT_SECONDS=8
NOTIFICATION_POLL_SECONDS=30
NOTIFICATION_SUMMARY_SECONDS=900
NOTIFICATION_ESCALATION_SECONDS=900

# 独立Windows计划每分钟运行python -m app.notifications.watchdog；不是应用自己给自己报平安。
# 机器外需另配Healthchecks检查与收件人。URL是秘密，只允许https://hc-ping.com/<UUID>。
# 专用probe令牌至少32位随机字符，不复用管理员/Agent/OneBot凭据。
NOTIFICATION_HEARTBEAT_ENABLED=false
NOTIFICATION_HEARTBEAT_URL=
NOTIFICATION_HEARTBEAT_PROBE_TOKEN=
# 必须与实际WEB_PORT相同；探针固定访问127.0.0.1，不接受任意远程URL。
NOTIFICATION_HEARTBEAT_LOCAL_PORT=8000

# ============================================================
# 以下为占位说明，真实凭据通过环境变量注入，绝不写入本文件：
# - QQ 官方机器人 AppID / AppSecret / Token
# - NapCat/OneBot 地址与令牌
# - 云模型 API Key
# - 管理后台会话密钥
# ============================================================
