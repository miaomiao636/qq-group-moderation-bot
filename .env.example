# ============================================================
# 环境变量模板（安全说明）
# 复制为 .env 后填写真实值。真实凭据绝不提交到仓库。
# 所有敏感字段只从环境变量或系统凭据存储读取。
# ============================================================

# 运行环境：local / test / prod（仅允许这三个值）
APP_ENV=local

# 运行模式：SAFE（安全模式，默认）/ CONVENIENT（便捷模式，需负责人确认后启用）
RUN_MODE=SAFE

# 官方动作执行模式：SHADOW 只记录；OFFICIAL 才允许调用QQ官方撤回/禁言/警告。
# OFFICIAL 还要求 APP_ENV=prod、QQ凭据、强管理员密码且 EMERGENCY_STOP=false。
ACTION_MODE=SHADOW
EMERGENCY_STOP=false

# 数据库连接串（SQLite WAL 默认；生产可改为 PostgreSQL）
# 示例：sqlite+aiosqlite:///./data/moderation.db
DATABASE_URL=sqlite+aiosqlite:///./data/moderation.db

# 管理后台监听地址与端口（默认仅本机，禁止无保护暴露公网）
# 端口范围 1-65535；通过 `uv run python -m app` 启动时生效
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 管理后台鉴权（生产环境 APP_ENV=prod 必须设置非空强口令，否则拒绝启动）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 数据保留期（天，必须 >= 1）
RAW_RETENTION_DAYS=30
DECISION_RETENTION_DAYS=180

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# QQ 官方机器人凭据（真实值只写入本地 .env 或系统凭据，不提交仓库）
QQ_APP_ID=
QQ_APP_SECRET=
QQ_API_BASE=https://api.bot.qq.com

# 远程AI辅助审核（默认关闭；按群显式启用；单模型只作为软证据）
AI_ENABLED=false
AI_ENABLED_GROUPS=
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=5
AI_DAILY_BUDGET_CENTS=0
AI_PER_MINUTE_LIMIT=30
AI_PROMPT_VERSION=t204-v1

# ============================================================
# 以下为占位说明，真实凭据通过环境变量注入，绝不写入本文件：
# - QQ 官方机器人 AppID / AppSecret / Token
# - NapCat/OneBot 地址与令牌
# - 云模型 API Key
# - 管理后台会话密钥
# ============================================================
